generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  super_admin
  admin
  coach
  member
}

enum Gender {
  male
  female
  unspecified
}

enum PaymentStatus {
  paid
  overdue
  pending
}

enum TrainingStatus {
  open
  closed
  cancelled
}

enum RegistrationStatus {
  registered
  cancelled
  attended
  no_show
  waitlisted
}

enum PlanStatus {
  draft
  published
}

enum MeasurementType {
  seconds
  distance_km
  distance_m
  minutes
  kg
}

enum GenderCategory {
  male
  female
  all
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

enum PlanType {
  monthly
  credits
}

enum CommentAuthorType {
  member
  coach
  admin
}

model Club {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  // Base64 data URL (resized on the client, ~30KB typical). null = fall back
  // to the platform Lumo logo in the app background.
  logoUrl              String?
  // Stripe Connect (Express) account for taking member payments directly to
  // this club's bank. `stripeAccountReady` flips true once Stripe fires
  // account.updated with charges_enabled=true.
  stripeConnectAccountId String?           @unique
  stripeAccountReady     Boolean           @default(false)
  notifyNewMember      Boolean               @default(false)
  notifyNewTraining    Boolean               @default(false)
  notifyPayment        Boolean               @default(false)
  country              String?               @default("LT")
  city                 String?
  address              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  users                User[]
  members              Member[]
  coaches              Coach[]
  trainingSessions     TrainingSession[]
  trainingTemplates    TrainingTemplate[]
  membershipPlans      MembershipPlan[]
  leaderboardCategories LeaderboardCategory[]
  trainingComments     TrainingComment[]
  subscription         ClubSubscription?
}

model ClubSubscription {
  id                   String             @id @default(cuid())
  clubId               String             @unique
  club                 Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  status               SubscriptionStatus @default(trialing)
  monthlyFee           Decimal            @default(0.01) @db.Decimal(10, 2)
  currency             String             @default("EUR")
  trialEndsAt          DateTime
  currentPeriodEnd     DateTime
  cancelledAt          DateTime?
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  cardBrand            String?
  cardLast4            String?
  cardExpMonth         Int?
  cardExpYear          Int?
  cardholderName       String?
  billingEmail         String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  role                Role
  name                String?
  clubId              String?
  club                Club?                @relation(fields: [clubId], references: [id], onDelete: Cascade)
  memberId            String?              @unique
  member              Member?              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  coachId             String?              @unique
  coach               Coach?               @relation(fields: [coachId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([clubId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MembershipPlan {
  id                String   @id @default(cuid())
  clubId            String
  club              Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name              String
  // For monthly: recurring monthly fee. For credits: one-time pack price.
  monthlyFee        Decimal  @db.Decimal(10, 2)
  currency          String   @default("EUR")
  // monthly = recurring subscription; credits = one-time pack of N trainings.
  planType          PlanType @default(monthly)
  // Only meaningful when planType=credits. Number of trainings the pack grants.
  creditCount       Int?
  // null = unlimited trainings per week; otherwise 1..N cap. Only used for
  // monthly plans — credit plans are capped by the credit balance.
  trainingsPerWeek  Int?
  // Mirrored on the club's Stripe Connect account so member payments can
  // reference a real Price. Populated lazily once the club connect is ready.
  // For monthly: recurring Price. For credits: one-time Price.
  stripeProductId   String?
  stripePriceId     String?
  members           Member[]

  @@index([clubId])
}

model Member {
  id                String    @id @default(cuid())
  clubId            String
  club              Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name              String
  email             String    @unique
  phone             String?
  dateOfBirth       DateTime?
  memberSince       DateTime  @default(now())
  gender            Gender    @default(unspecified)
  ageGroup          String?
  avatarColor       String?
  initials          String?
  photoUrl          String?
  coachNotes        String?
  membershipPlanId  String?
  membershipPlan    MembershipPlan? @relation(fields: [membershipPlanId], references: [id])
  paymentStatus     PaymentStatus @default(pending)
  paymentDueDate    DateTime?
  lastPaymentDate   DateTime?
  notifyEmail       Boolean   @default(true)
  notifySms         Boolean   @default(false)
  notifyPush        Boolean   @default(true)
  registrations     TrainingRegistration[]
  trainingPlans     TrainingPlan[]
  results           LeaderboardResult[]
  user              User?
  // Stripe Customer + Subscription live on the club's connected account, so
  // both ids are only unique in combination with the club — but Stripe issues
  // globally unique ids either way, so we keep them @unique for cheap lookup.
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  // For credit-pack plan members. null = not applicable (monthly plan). Any
  // integer >= 0 = trainings still available. Decremented on registration,
  // restored on cancellation.
  creditsRemaining     Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([clubId])
}

model Coach {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  specialty   String?
  avatarColor String?
  initials    String?
  phone       String?
  photoUrl    String?
  sessions    TrainingSession[]
  user        User?

  @@index([clubId])
}

model TrainingSession {
  id                   String   @id @default(cuid())
  clubId               String
  club                 Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  coachId              String
  coach                Coach    @relation(fields: [coachId], references: [id])
  title                String
  description          String?
  date                 DateTime @db.Date
  startTime            String
  endTime              String
  location             String?
  capacity             Int
  registrationDeadline DateTime?
  goals                String[]
  whatToBring          String[]
  // Shared training plan applied to every registered member. When a member
  // registers, we auto-create a TrainingPlan row for them seeded with this
  // text. The coach can then edit each member's plan individually without
  // touching the shared template.
  defaultPlan          String?
  status               TrainingStatus @default(open)
  registrations        TrainingRegistration[]
  trainingPlans        TrainingPlan[]
  comments             TrainingComment[]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([clubId])
}

model TrainingRegistration {
  id                String   @id @default(cuid())
  trainingSessionId String
  session           TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  memberId          String
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status            RegistrationStatus @default(registered)
  registeredAt      DateTime @default(now())

  @@unique([trainingSessionId, memberId])
}

// Reusable training template. Coaches/admins define these ahead of time and
// pick one when creating a TrainingSession to pre-fill its fields. Purely a
// convenience — there's no runtime linkage back from a session to the
// template it was created from.
model TrainingTemplate {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name         String
  title        String?
  description  String?
  location     String?
  startTime    String?
  endTime      String?
  capacity     Int?
  defaultPlan  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clubId])
}

model TrainingPlan {
  id                String   @id @default(cuid())
  memberId          String
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainingSessionId String?
  session           TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  title             String
  durationMinutes   Int?
  coachNote         String?
  planBody          String?
  status            PlanStatus @default(draft)
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model LeaderboardCategory {
  id              String   @id @default(cuid())
  clubId          String
  club            Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name            String
  event           String
  measurementType MeasurementType
  unit            String
  lowerIsBetter   Boolean
  genderCategory  GenderCategory @default(all)
  archived        Boolean  @default(false)
  results         LeaderboardResult[]

  @@index([clubId])
}

model LeaderboardResult {
  id         String   @id @default(cuid())
  categoryId String
  category   LeaderboardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  value      Decimal  @db.Decimal(12, 3)
  date       DateTime @db.Date
  note       String?
}

model TrainingComment {
  id                String            @id @default(cuid())
  clubId            String
  club              Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  trainingSessionId String
  session           TrainingSession   @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  authorId          String
  authorType        CommentAuthorType
  authorName        String
  body              String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([trainingSessionId])
  @@index([clubId])
}

// Platform-level meeting bookings made via the public /help page.
model Meeting {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  startTime     String   // HH:MM, e.g. "09:00"
  bookedByName  String
  bookedByEmail String
  inviteEmails  String[]
  createdAt     DateTime @default(now())

  @@unique([date, startTime])
}
